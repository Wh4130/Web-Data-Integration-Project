<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <xs:annotation>
    <xs:documentation>
      Integrated schema for the Airport Data Integration project (Team 5, WDI HWS 2026).
      Combines complementary and overlapping attributes from three input sources:
      OurAirports, Wikidata (via QLever), and the Kaggle Global Airports Dataset.
      See the proposal, Section 2.3 ("Integrated Schema and Overlap with Input Schemata"),
      for the attribute-to-source mapping and overlap analysis this schema is based on.
      A populated example is given in sample.xml in this same folder.
    </xs:documentation>
  </xs:annotation>

  <xs:element name="Airports">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Airport" type="AirportType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="AirportType">
    <xs:annotation>
      <xs:documentation>
        One integrated airport record. Entity identity across sources is established via a
        combination of name, coordinates, and country/location attributes (not via
        IATA/ICAO/FAA codes, which are reserved as a gold-standard evaluation set instead
        of a matching key).
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>

      <xs:element name="name" type="xs:string">
        <xs:annotation>
          <xs:documentation>Airport name. In all 3 sources (Kaggle: AirportName, Wikidata: name, OurAirports: name).</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="type" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Airport type (e.g. large_airport, medium_airport, small_airport, heliport, closed). OurAirports only (type).</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="scheduledService" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Whether the airport has scheduled airline service. OurAirports only (scheduled_service, yes/no).</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="iata" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>3-letter IATA code. In all 3 sources. Evaluation-only identifier, not used for entity matching.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="icao" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>4-letter ICAO code. In all 3 sources. Evaluation-only identifier, not used for entity matching.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="localCode" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Local/FAA airport code. In Wikidata (faa) and OurAirports (local_code); not in Kaggle.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="lat" type="xs:decimal" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Latitude in decimal degrees. In all 3 sources (Kaggle: GeoPointLat, Wikidata: lat, OurAirports: latitude_deg). Resolved jointly with lon during fusion.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="lon" type="xs:decimal" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Longitude in decimal degrees. In all 3 sources (Kaggle: GeoPointLong, Wikidata: lon, OurAirports: longitude_deg). Resolved jointly with lat during fusion.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="elevation" type="xs:decimal" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Elevation above sea level, normalized to metres. In Wikidata and OurAirports; not in Kaggle.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="countryCode" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>ISO 3166-1 alpha-2 code of the country in which the airport is located. In Kaggle (Country_CodeA2) and OurAirports (iso_country); not in Wikidata.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="countryCodeA3" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>ISO 3166-1 alpha-3 country code. Kaggle only (Country_CodeA3).</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="countryName" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Name of the country in which the airport is located. In Kaggle (Country_Name) and Wikidata (country); not in OurAirports.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="continent" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Continent code (e.g. EU, NA). OurAirports only (continent).</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="isoRegion" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>ISO 3166-2 region code (e.g. US-OH). OurAirports only (iso_region).</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="city" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>City/municipality. In all 3 sources (Kaggle: City_Name, Wikidata: located_in, OurAirports: municipality).</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="cityIata" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>IATA code of the city served (may differ from the airport's own IATA code). Kaggle only (City_IATA).</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="timezone" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Time zone of the airport's location. In Kaggle and Wikidata; not in OurAirports.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="operator" type="xs:string" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Operating organization(s). List-valued. Wikidata only.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="owner" type="xs:string" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Owning organization(s). List-valued. Wikidata only.</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="runway" type="RunwayType" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Runways of the airport. List-valued. OurAirports only (joined from runways.csv via airport_ident).</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="homepage" type="xs:anyURI" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Official airport website. OurAirports only (home_link).</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="wikipedia" type="xs:anyURI" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Wikipedia article URL. OurAirports only (wikipedia_link).</xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="wikidataURI" type="xs:anyURI" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Wikidata entity URI of the airport. Wikidata only (airport).</xs:documentation>
        </xs:annotation>
      </xs:element>

    </xs:sequence>

    <xs:attribute name="id" type="xs:ID" use="required">
      <xs:annotation>
        <xs:documentation>
          Unique record identifier in the form {source_prefix}_{uid}. source_prefix is one of
          wd (Wikidata), oa (OurAirports) or kg (Kaggle). Not every source has its own id
          column, so uid is a sequence number assigned by the pipeline: the 0-based row index
          of the record in that source's interim CSV (e.g. wd_531, oa_39281, kg_0). It is not
          mapped from a source attribute. For a fused record it is the id of the source
          record that serves as the base of the cluster.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="RunwayType">
    <xs:annotation>
      <xs:documentation>Mirrors the relevant columns of OurAirports' runways.csv.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="lengthFt" type="xs:decimal" minOccurs="0"/>
      <xs:element name="widthFt" type="xs:decimal" minOccurs="0"/>
      <xs:element name="surface" type="xs:string" minOccurs="0"/>
      <xs:element name="lighted" type="xs:boolean" minOccurs="0"/>
      <xs:element name="closed" type="xs:boolean" minOccurs="0"/>
      <xs:element name="leIdent" type="xs:string" minOccurs="0">
        <xs:annotation><xs:documentation>Low-end runway identifier (runways.csv: le_ident).</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="heIdent" type="xs:string" minOccurs="0">
        <xs:annotation><xs:documentation>High-end runway identifier (runways.csv: he_ident).</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
